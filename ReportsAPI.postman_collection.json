    {
      "name": "History Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var response = JSON.parse(responseBody);",
              "if (response && 'report_id' in response) {",
              "    postman.setEnvironmentVariable('report_id', JSON.parse(responseBody).report_id);",
              "}",
              "    ",
              ""
            ],
