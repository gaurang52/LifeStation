            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n\t\"servco_no\": \"880900\",\n\t\"before\": \"2017-10-11 00:00:00\",\n\t\"after\": \"2017-10-01 00:00:00\",\n\t\"cs_start\": \"0000000\",\n\t\"cs_end\": \"9999999\",\n\t\"signal_type\": [\"TT\",\"TF\"],\n\t\"title\": \"Test Report TT TF w/corpacct\"\n}"
        },
        "url": {
          "raw": "https://{{base_url}}.alertmessage.com/report/history",
          "protocol": "https",
          "host": ["{{base_url}}", "alertmessage", "com"],
          "path": ["report", "history"]
        },
        "description": "Documentation from the PhP validation function:\n    /**\n     * Validates a request for an ssrs_event_history_report_v2 via the REST API.  Descriptions of validations in the example.\n     * Unspecified parameters are ignored.  Data must be sent as raw JSON.\n     *\n     * @uses php://input\n     * @uses self::eventrpt_ids\n     * @throws Exception when validation fails (details in the example)\n     * @param string $username The secuser in MAS\n     * @example POST input {\n     *  @type string $before              (optional) A datestamp in format \"YYYY/MM/DD HH:mm:SS\".  Filters out events in all subsequent dates.\n     *                                      @throws Exception if the string is not in that format or if it does not correspond to a calendar date.\n     *                                      Defaults to time of request.\n     *  @type string $after               (optional) Same as $before but filters events on dates previous.  Defaults to today - 30 days.\n     *  @type array $signaltype           (optional) An array of strings.  Each item must be a string and correspond to a MAStermind\n     *                                      [event_report_code][eventrpt_id], which are cached in Oauth_reports::eventrpt_ids_cachename.\n     *                                      @throws Exception if not an array or if a non-string in the array or if a non-eventrpt_id is in the string.\n     *  @type string $cs_start            (optional) A cs_no that represents the beginning of a range of cs_nos.  @throws Exception if present w/o cs_end or is not\n     *                                      a string.\n     *  @type string $cs_end              (optional) @throws Exception if not a string or is present w/o cs_start, otherwise same as $cs_start.\n     *  @type string $servco_no           (optional) @throws Exception if not a string.\n     *  @type string $corpacct_servco_no  (optional) @throws Exception if not a string.\n     *  @type string $title               (optional) defaults to APIReport<<timestamp>> @throws Exception if string exceeds 40 char limit\n     * }\n     * @return array The validated parameters re-formed for the SSRS server.\n     */"
      },
      "response": []
    },
