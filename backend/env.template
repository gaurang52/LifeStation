# ============================================
# Brighton Backend - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# Command: cp env.template .env

# Server Configuration
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration
# ============================================
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=brighton_db
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
DB_DRIVER=pg

# Database Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# JWT Configuration
# ============================================
# Generate secure random keys for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-characters-long
REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-this-in-production-min-32-characters-long

# ============================================
# External API Configuration
# ============================================
# Base URL for external APIs - subdomain only (without protocol or domain)
# Examples:
#   - If full URL is https://qa1-api.alertmessage.com, set to: qa1-api
#   - If full URL is https://api.alertmessage.com, set to: api
#   - The code will automatically add https:// and .alertmessage.com
#   - You can also provide full URL (https://qa1-api.alertmessage.com) and it will be normalized
EXTERNAL_API_BASE_URL=your-base-url

# External API Credentials (shared across Account, Device, and Reports APIs)
EXTERNAL_API_USERNAME=your-external-api-username
EXTERNAL_API_PASSWORD=your-external-api-password

# ============================================
# Encryption Configuration
# ============================================
# Generate a 32-byte (64 hex characters) encryption key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-64-characters-long-change-in-production

# ============================================
# Redis Configuration (Optional - for caching)
# ============================================
# Leave empty if Redis is not available (caching will be disabled)
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# ============================================
# Firebase Configuration (Optional - for push notifications)
# ============================================
# Firebase Admin SDK credentials
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ============================================
# Rate Limiting Configuration
# ============================================
# General API rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External API rate limiting (stricter to prevent quota exhaustion)
EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000
EXTERNAL_API_RATE_LIMIT_MAX_REQUESTS=10

# ============================================
# Email Configuration (for sending invitations)
# ============================================
# Gmail Service Configuration for sending emails
# Leave empty to use test account (emails won't be sent in production)
GMAIL_SERVICE_NAME=gmail
GMAIL_SERVICE_HOST=smtp.gmail.com
GMAIL_SERVICE_PORT=587
GMAIL_SERVICE_SECURE=false
GMAIL_USER_NAME=your-email@gmail.com
GMAIL_USER_PASSWORD=your-app-password
FROM_NAME=LifeStation

# Frontend URL for invitation links
FRONTEND_URL=http://localhost:3000

# ============================================
# Logging Configuration
# ============================================
# Log levels: error, warn, info, debug
LOG_LEVEL=info

