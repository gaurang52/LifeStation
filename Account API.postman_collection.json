    {
      "name": "Get Accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = JSON.parse(responseBody);",
              "for (var i in jsonData.accounts) {",
              "    var acct = jsonData.accounts[i];",
              "    if (acct.status == \"A\") {",
              "        postman.setEnvironmentVariable(\"cs_no\", acct.cs_no);",
              "        break;",
              "    }",
              "}",
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "https://{{base_url}}.alertmessage.com/acct/",
          "protocol": "https",
          "host": ["{{base_url}}", "alertmessage", "com"],
          "path": ["acct", ""]
        }
      },
      "response": []
