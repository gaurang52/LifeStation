    {
      "name": "Authentication",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(pm.response.text());",
              "pm.environment.set(\"access_token\", jsonData.access_token);",
              "pm.environment.set(\"refresh_token\", jsonData.refresh_token);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "username",
              "value": "{{username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{vault:accountAPIpassword}}",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "affiliated-api",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "https://{{base_url}}.alertmessage.com/token",
